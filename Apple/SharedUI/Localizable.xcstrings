    "Pooled capacity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pooled capacity"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączny zapas"
          }
        }
      }
    },
    "Pooled capacity: remaining quota of every enabled account added up, so three accounts make %@. A cooling account counts as 0 until its cooldown ends, a window whose reset has passed counts as full, and an account without a sample is listed separately.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pooled capacity: remaining quota of every enabled account added up, so three accounts make %@. A cooling account counts as 0 until its cooldown ends, a window whose reset has passed counts as full, and an account without a sample is listed separately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączny zapas: pozostały limit wszystkich włączonych kont zsumowany, więc trzy konta to %@. Konto wstrzymane liczy się jako 0 do końca wstrzymania, okno po resecie liczy się jako pełne, a konto bez próbki jest pokazane osobno."
          }
        }
      }
    },
    "Primary provider": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
