    },
    "The server address is not valid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address is not valid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres serwera jest nieprawidłowy."
          }
        }
      }
    },
    "The server and its key are removed from this device. Nothing changes on the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server and its key are removed from this device. Nothing changes on the server."
          }
        },
        "pl": {
