          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana nie została wysłana, bo w czasie oczekiwania serwer odrzucił klucz. Odśwież, aby sprawdzić klucz, a potem spróbuj zmiany ponownie."
          }
        }
      }
    },
    "The configuration changed on the server in the meantime. The current value is shown now; try again if you still want the change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration changed on the server in the meantime. The current value is shown now; try again if you still want the change."
          }
