    "5-hour": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5-hour"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "5-godzinny"
          }
        }
      }
    },
    "A Claude or Codex account that reports other windows but no 5-hour window has no 5-hour window running. It is listed as \"No 5-hour window\" and left out of the 5-hour capacity, because the proxy does not say whether that window is idle or does not exist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Claude or Codex account that reports other windows but no 5-hour window has no 5-hour window running. It is listed as \"No 5-hour window\" and left out of the 5-hour capacity, because the proxy does not say whether that window is idle or does not exist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto Claude lub Codex, które zgłasza inne okna, ale nie zgłasza okna 5-godzinnego, nie ma uruchomionego okna 5-godzinnego. Jest pokazane jako „Brak okna 5-godzinnego” i pominięte w 5-godzinnym zapasie, bo proxy nie mówi, czy to okno czeka na użycie, czy w ogóle nie istnieje."
          }
        }
      }
    },
    "A client key (from access.api-keys) shows models and, on servers that offer /v1/fleet/limits, quota bars. It cannot change anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A client key (from access.api-keys) shows models and, on servers that offer /v1/fleet/limits, quota bars. It cannot change anything."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz klienta (z access.api-keys) pokazuje modele, a na serwerach z /v1/fleet/limits także paski limitów. Nie pozwala niczego zmieniać."
          }
        }
      }
    },
