    },
    "Active data: numbers with %@ come from Refresh limits, where the server asks the provider with the account's own sign-in. That happens only when you press Refresh limits, or on a schedule while the app is visible and automatic provider refresh is on for this server in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active data: numbers with %@ come from Refresh limits, where the server asks the provider with the account's own sign-in. That happens only when you press Refresh limits, or on a schedule while the app is visible and automatic provider refresh is on for this server in Settings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane aktywne: liczby oznaczone %@ pochodzą z „Odśwież limity”, gdy serwer pyta dostawcę, używając logowania danego konta. Dzieje się to tylko po naciśnięciu „Odśwież limity” albo według harmonogramu, gdy aplikacja jest widoczna, a automatyczne odświeżanie limitów od dostawców jest włączone dla tego serwera w Ustawieniach."
          }
        }
      }
    },
    "Add a server in Proxy Gauge to see its quota here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a server in Proxy Gauge to see its quota here."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj serwer w Proxy Gauge, aby zobaczyć tu jego limity."
          }
        }
      }
    },
