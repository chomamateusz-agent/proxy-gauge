    "Proxy Gauge never reads or shows client key values. Servers that publish client-key policies also show how many keys are configured.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy Gauge never reads or shows client key values. Servers that publish client-key policies also show how many keys are configured."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy Gauge nigdy nie odczytuje ani nie pokazuje wartości kluczy klientów. Serwery, które udostępniają zasady kluczy klientów, pokazują też, ile kluczy skonfigurowano."
          }
        }
      }
    },
    "Proxy Gauge refreshes only the screen you are looking at, and only while the app is open. It reads what the proxy already knows and never asks providers for quota.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy Gauge refreshes only the screen you are looking at, and only while the app is open. It reads what the proxy already knows and never asks providers for quota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
