            "value": "Wszystkie"
          }
        }
      }
    },
    "Antigravity uses unofficial Google endpoints, and Google's terms restrict access by third-party tools. Refresh these accounts only if you accept that risk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravity uses unofficial Google endpoints, and Google's terms restrict access by third-party tools. Refresh these accounts only if you accept that risk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravity korzysta z nieoficjalnych endpointów Google, a warunki Google ograniczają dostęp narzędziom firm trzecich. Odświeżaj te konta tylko wtedy, gdy akceptujesz to ryzyko."
          }
        }
      }
    },
    "Ask the providers for fresh limits through the server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the providers for fresh limits through the server"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś dostawców o aktualne limity przez serwer"
          }
        }
      }
    },
    "At limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At limit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit wyczerpany"
          }
        }
      }
    },
    "At most %lld requests, sent one at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most %lld requests, sent one at a time."
