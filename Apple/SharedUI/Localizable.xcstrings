        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytania: najwyżej %lld, wysyłane po jednym."
          }
        }
      }
    },
    "Auto refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto refresh"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie"
          }
        }
      }
    },
    "Automatic limit refresh is paused for this account after repeated rate limits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic limit refresh is paused for this account after repeated rate limits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie limitów tego konta jest wstrzymane po kolejnych limitach zapytań od dostawcy."
          }
        }
      }
    },
    "Automatic refresh is off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic refresh is off"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie wyłączone"
          }
        }
      }
    },
    "Automatic refresh is off — pull to refresh or press Refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic refresh is off — pull to refresh or press Refresh."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie jest wyłączone — pociągnij, aby odświeżyć, albo naciśnij Odśwież."
          }
        }
      }
    },
    "Automatic refresh is off. Refresh in Proxy Gauge to save values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic refresh is off. Refresh in Proxy Gauge to save values."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie jest wyłączone. Odśwież w Proxy Gauge, aby zapisać wartości."
          }
        }
      }
    },
    "Automatic refresh is paused because the server has temporarily blocked this network address after too many failed key attempts, possibly by another client. The key may be fine. Refresh to try again once the block ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic refresh is paused because the server has temporarily blocked this network address after too many failed key attempts, possibly by another client. The key may be fine. Refresh to try again once the block ends."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie jest wstrzymane, bo serwer tymczasowo zablokował ten adres sieciowy po zbyt wielu nieudanych próbach klucza, być może z innego klienta. Klucz może być poprawny. Odśwież ręcznie, gdy blokada minie."
          }
        }
      }
    },
    "Automatic refresh is paused because the server rejected the key, so repeated attempts do not get this device banned. Edit the server to fix the key, or refresh to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic refresh is paused because the server rejected the key, so repeated attempts do not get this device banned. Edit the server to fix the key, or refresh to try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odświeżanie jest wstrzymane, bo serwer odrzucił klucz; kolejne próby mogłyby zablokować to urządzenie. Popraw klucz w edycji serwera albo odśwież ręcznie, aby spróbować ponownie."
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępne"
          }
        }
      }
    },
    "Bars marked with %@ come from the provider; the others come from what the proxy saw in traffic. For each window the newer reading wins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars marked with %@ come from the provider; the others come from what the proxy saw in traffic. For each window the newer reading wins."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paski oznaczone %@ pochodzą od dostawcy, pozostałe z tego, co proxy zobaczyło w ruchu. Dla każdego okna wygrywa nowszy odczyt."
          }
        }
      }
    },
    "Best account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best account"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepsze konto"
          }
        }
      }
    },
    "Best account: the most quota a single account that can take requests has left in its tightest window. Shown when at least two accounts can take requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best account: the most quota a single account that can take requests has left in its tightest window. Shown when at least two accounts can take requests."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepsze konto: największy limit, jaki zostało jednemu kontu zdolnemu przyjmować żądania, w jego najciaśniejszym oknie. Pokazywane, gdy żądania mogą przyjmować co najmniej dwa konta."
          }
        }
      }
    },
