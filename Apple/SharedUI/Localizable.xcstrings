          }
        }
      }
    },
    "The management key (management.secret-key) unlocks accounts, usage and settings. For remote access the server needs management.allow-remote: true.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The management key (management.secret-key) unlocks accounts, usage and settings. For remote access the server needs management.allow-remote: true."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz zarządzania (management.secret-key) daje dostęp do kont, użycia i ustawień. Do zdalnego dostępu serwer potrzebuje management.allow-remote: true."
          }
        }
      }
    },
    "The models of this account could not be read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The models of this account could not be read."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać modeli tego konta."
          }
        }
      }
    },
    "The proxy applies the new strategy to the next requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy applies the new strategy to the next requests."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy zastosuje nową strategię do kolejnych zapytań."
          }
        }
      }
    },
    "The proxy starts routing requests to this account again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy starts routing requests to this account again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy znów zacznie kierować zapytania do tego konta."
          }
        }
      }
    },
    "The proxy stops routing requests to this account until you enable it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy stops routing requests to this account until you enable it again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy przestanie kierować zapytania do tego konta, dopóki go nie włączysz."
          }
        }
      }
    },
    "The proxy will try this account again right away. If the provider still limits it, it will cool down again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy will try this account again right away. If the provider still limits it, it will cool down again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy od razu spróbuje znowu użyć tego konta. Jeśli dostawca nadal je ogranicza, konto znów zostanie wstrzymane."
          }
        }
      }
    },
    "The server address is not valid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address is not valid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres serwera jest nieprawidłowy."
          }
        }
      }
    },
    "The server and its key are removed from this device. Nothing changes on the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server and its key are removed from this device. Nothing changes on the server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer i jego klucz zostaną usunięte z tego urządzenia. Na serwerze nic się nie zmieni."
          }
        }
      }
    },
    "The server did not report a configuration version, so this write is unconditional: if someone changed the routing strategy on the server since it was read here, their change is overwritten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not report a configuration version, so this write is unconditional: if someone changed the routing strategy on the server since it was read here, their change is overwritten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie podał wersji konfiguracji, więc ten zapis jest bezwarunkowy: jeśli ktoś zmienił strategię routingu na serwerze, odkąd została tu odczytana, jego zmiana zostanie nadpisana."
          }
        }
      }
    },
    "The server does not offer this endpoint (HTTP 404). Management may be disabled or the address may include the wrong path.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server does not offer this endpoint (HTTP 404). Management may be disabled or the address may include the wrong path."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie udostępnia tego adresu (HTTP 404). Zarządzanie może być wyłączone albo adres zawiera złą ścieżkę."
          }
        }
      }
    },
    "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. It accepts keys again at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. It accepts keys again at %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tymczasowo zablokował ten adres sieciowy po zbyt wielu nieudanych próbach klucza z niego, być może z innego klienta. Ponownie przyjmie klucze o %@."
          }
        }
      }
    },
    "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. Try again later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tymczasowo zablokował ten adres sieciowy po zbyt wielu nieudanych próbach klucza z niego, być może z innego klienta. Spróbuj ponownie później."
          }
        }
      }
    },
    "The server has temporarily blocked this network address. Open Proxy Gauge to retry later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has temporarily blocked this network address. Open Proxy Gauge to retry later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tymczasowo zablokował ten adres sieciowy. Otwórz Proxy Gauge, aby spróbować później."
          }
        }
      }
    },
