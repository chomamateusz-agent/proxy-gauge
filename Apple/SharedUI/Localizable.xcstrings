    },
    "Best remaining quota across usable accounts, from rate-limit headers the proxy already observed. Proxy Gauge never asks providers for quota.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best remaining quota across usable accounts, from rate-limit headers the proxy already observed. Proxy Gauge never asks providers for quota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największy pozostały limit spośród dostępnych kont, według nagłówków limitów, które proxy już zarejestrowało. Proxy Gauge nigdy nie odpytuje dostawców o limity."
          }
        }
      }
    },
