          "stringUnit": {
            "state": "translated",
            "value": "Liczone przez proxy od jego uruchomienia, dla wszystkich kont i kluczy API dostawców."
          }
        }
      }
    },
    "Counted by the proxy since it started. The upstream API-key counters could not be refreshed, so their share may be out of date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted by the proxy since it started. The upstream API-key counters could not be refreshed, so their share may be out of date."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczone przez proxy od jego uruchomienia. Nie udało się odświeżyć liczników kluczy API dostawców, więc ich udział może być nieaktualny."
