        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne zarządzanie jest na tym serwerze wyłączone. Ustaw management.allow-remote na true w jego konfiguracji."
          }
        }
      }
    },
    "Remove the user name and password from the address. Proxy Gauge only sends the key entered below.": {
