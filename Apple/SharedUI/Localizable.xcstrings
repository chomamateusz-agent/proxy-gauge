            "state": "translated",
            "value": "Overview"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd"
          }
        }
      }
    },
    "Passive data: numbers without a mark come from rate-limit headers the proxy already observed while serving requests. Reading them sends nothing to the providers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive data: numbers without a mark come from rate-limit headers the proxy already observed while serving requests. Reading them sends nothing to the providers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane pasywne: liczby bez oznaczenia pochodzą z nagłówków limitów, które proxy już zarejestrowało podczas obsługi zapytań. Ich odczyt nie wysyła niczego do dostawców."
          }
        }
      }
    },
    "Paste the key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the key"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej klucz"
          }
        }
      }
    },
    "Plain HTTP sends your key unencrypted over this route. Prefer HTTPS, or a private network such as Tailscale.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain HTTP sends your key unencrypted over this route. Prefer HTTPS, or a private network such as Tailscale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykłe HTTP przesyła klucz tą trasą bez szyfrowania. Lepiej użyć HTTPS albo sieci prywatnej, na przykład Tailscale."
          }
        }
      }
    },
    "Plan": {
      "localizations": {
