            "state": "translated",
            "value": "Nie udało się odświeżyć u dostawcy: %@"
          }
        }
      }
    },
    "Provider refresh requires management access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider refresh requires management access."
          }
        },
