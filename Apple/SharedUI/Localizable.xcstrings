          }
        }
      }
    },
    "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. It accepts keys again at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. It accepts keys again at %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tymczasowo zablokował ten adres sieciowy po zbyt wielu nieudanych próbach klucza z niego, być może z innego klienta. Ponownie przyjmie klucze o %@."
          }
        }
      }
    },
    "The server has temporarily blocked this network address after too many failed key attempts from it, possibly by another client. Try again later.": {
