          }
        }
      }
    },
    "Refresh limits needs the management key: a client key cannot ask the server to contact providers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh limits needs the management key: a client key cannot ask the server to contact providers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżanie limitów wymaga klucza zarządzania: klucz klienta nie może poprosić serwera o kontakt z dostawcami."
          }
        }
      }
    },
    "Refreshing limits never redeems manual resets, never spends reset credits and never retries through another route. Providers that answer with a rate limit are left alone until they allow it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing limits never redeems manual resets, never spends reset credits and never retries through another route. Providers that answer with a rate limit are left alone until they allow it again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżanie limitów nigdy nie wykorzystuje ręcznych resetów, nie wydaje kredytów resetów i nie ponawia zapytań inną drogą. Dostawcy, którzy odpowiedzą limitem zapytań, nie są pytani, dopóki znów na to nie pozwolą."
          }
        }
      }
    },
    "Remaining quota of all your accounts added up, per provider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining quota of all your accounts added up, per provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostały limit wszystkich Twoich kont zsumowany dla każdego dostawcy."
          }
        }
      }
    },
    "Remote management is disabled on this server. Set management.allow-remote to true in its config.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote management is disabled on this server. Set management.allow-remote to true in its config."
